<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF1F5">


    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:background="#111827"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Whiteboard"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Interactive Canvas"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                android:singleLine="true" />

        </LinearLayout>



        <ImageButton
            android:id="@+id/undoButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_top_icon"
            android:contentDescription="Undo"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_undo"
            android:tint="#FFFFFF" />



        <ImageButton
            android:id="@+id/redoButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_top_icon"
            android:contentDescription="Redo"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_redo"
            android:tint="#FFFFFF" />



        <ImageButton
            android:id="@+id/saveButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_top_icon"
            android:contentDescription="Save"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_save"
            android:tint="#FFFFFF" />



        <ImageButton
            android:id="@+id/loadButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_top_icon"
            android:contentDescription="Load"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_folder"
            android:tint="#FFFFFF" />



        <ImageButton
            android:id="@+id/exportButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_top_icon"
            android:contentDescription="Export"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_image"
            android:tint="#FFFFFF" />

    </LinearLayout>



    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_canvas_rich"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.whiteboardifp.views.WhiteboardCanvasView
            android:id="@+id/canvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

    </FrameLayout>



    <LinearLayout
        android:id="@+id/toolBar"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="18dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_toolbar"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageButton
            android:id="@+id/selectButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tool_icon"
            android:contentDescription="Select"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_select"
            android:tint="#E5E7EB" />



        <ImageButton
            android:id="@+id/penButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tool_selected"
            android:contentDescription="Pen"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pen"
            android:tint="#FFFFFF" />



        <ImageButton
            android:id="@+id/eraserButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tool_icon"
            android:contentDescription="Eraser"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_eraser"
            android:tint="#E5E7EB" />



        <ImageButton
            android:id="@+id/textButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tool_icon"
            android:contentDescription="Text"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_text"
            android:tint="#E5E7EB" />



        <ImageButton
            android:id="@+id/shapeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tool_icon"
            android:contentDescription="Shape"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shape"
            android:tint="#E5E7EB" />



        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tool_icon"
            android:contentDescription="Delete"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            android:tint="#F87171" />

    </LinearLayout>



    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_properties"
        android:elevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Stroke size"
            android:src="@drawable/ic_stroke"
            android:tint="#D1D5DB" />


        <SeekBar
            android:id="@+id/strokeSeekBar"
            android:layout_width="125dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:max="40"
            android:progress="5" />


        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#374151" />



        <LinearLayout
            android:id="@+id/colorContainer"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="3dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>